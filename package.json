    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vite-plugin-commonjs": "^0.10.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
